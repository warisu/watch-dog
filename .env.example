# Postgres connection (Vercel Postgres, Neon, or Supabase all work)
DATABASE_URL="postgresql://user:password@host:5432/sentinel?sslmode=require"

# Shared secret the standalone mempool bot must send in the
# `x-sentinel-signature` header when POSTing to /api/webhooks/mempool
INGEST_WEBHOOK_SECRET="change-me"

# Outbound notification channels (all optional, leave blank to disable)
DISCORD_WEBHOOK_URL=""
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""

# Dashboard basic-auth style access (simple gate, swap for real auth later)
DASHBOARD_ACCESS_TOKEN="change-me-too"
